DATABASE_URL=postgres://scout:scout_local_only@localhost:5434/scoutanywhere
# Test commands require a separate, seeded database with the same migrations.
TEST_DATABASE_URL=postgres://scout:scout_local_only@localhost:5434/scoutanywhere_test
# Generate with: openssl rand -base64 48. Never commit a real secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=ScoutAnywhere <noreply@scout.local>
# Production SMTP (use TLS); leave user/password empty for local Mailpit.
SMTP_USER=
SMTP_PASSWORD=
# Leave empty unless an ingress OVERWRITES this header and blocks direct origin access.
# Without a trusted header auth uses a shared per-path rate-limit bucket (safe, restrictive).
AUTH_TRUSTED_IP_HEADER=
# Local object storage lives outside public/, ignored by Git, with owner-only files.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=.private-media/development
TEST_MEDIA_LOCAL_ROOT=.private-media/test
MEDIA_MAX_IMAGES=12
MEDIA_MAX_ORIGINAL_BYTES=10485760
MEDIA_MAX_PIXELS=40000000
MEDIA_MAX_DIMENSION=12000
MEDIA_ACCOUNT_BYTES=262144000
MEDIA_ACCOUNT_IMAGES=240
# Optional private S3-compatible storage. Never use NEXT_PUBLIC_ for these values.
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=